# Telegram
TELEGRAM_ASSISTANT_TOKEN=your_telegram_bot_token
OWNER_TELEGRAM_ID=your_telegram_user_id

# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_ASSISTANT_MODEL=your_model_name
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=2000
OPENAI_TRANSCRIBE_MODEL=your_transcription_model

# Google Calendar / Tasks
GOOGLE_CREDENTIALS_FILE=/path/to/service-account.json
GOOGLE_CALENDAR_ID=your_calendar_id
GOOGLE_OZON_CALENDAR_ID=optional_calendar_id
GOOGLE_PERSONAL_CALENDAR_ID=optional_calendar_id
GOOGLE_PROJECTS_CALENDAR_ID=optional_calendar_id

# Clippy Gateway
CLIPPY_GATEWAY_API_KEY=change_me
CLIPPY_PROJECT_SYNC_API_KEY=change_me
CLIPPY_GATEWAY_PUBLIC_URL=http://127.0.0.1:8765

# Weather
CLIPPY_WEATHER_CITY=Example City
CLIPPY_WEATHER_LAT=0.0
CLIPPY_WEATHER_LON=0.0

# Optional integration
CLIENT_BOT_SERVICE=client-bot.service
